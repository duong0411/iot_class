PORT=3001
# MongoDB tuỳ chọn — để trống nếu không dùng
# MONGODB_URI=mongodb://host.docker.internal:27018/alot_db
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# Public URL (1 domain — path /api/schedule, /audio, /ws)
SERVER_BASE_URL=https://duynguyen.io.vn

# MQTT nội bộ tới Mosquitto trên host (Docker → host)
MQTT_URL=mqtt://host.docker.internal:1883
MQTT_PUBLIC_HOST=mqtt.duynguyen.io.vn
MQTT_PUBLIC_PORT=443

# XiaoZhi MCP — agent LỚP HỌC (khác token nhà thông minh)
XIAOZHI_MCP_URL=wss://api.xiaozhi.me/mcp/?token=YOUR_CLASSROOM_TOKEN
